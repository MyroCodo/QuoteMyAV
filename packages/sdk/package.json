{
  "name": "@quotemyav/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the QuoteMyAV API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-typescript-codegen --input ../../docs/api/openapi.yaml --output ./src/generated --client fetch --useOptions",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "quotemyav",
    "av",
    "audio-visual",
    "quotes",
    "api",
    "sdk"
  ],
  "author": "QuoteMyAV",
  "license": "MIT",
  "devDependencies": {
    "openapi-typescript-codegen": "^0.29.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": ">=4.7.0"
  }
}
