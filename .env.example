# ===========================================
# AWS Cognito (Primary Auth - NEW)
# ===========================================
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# Supabase (Legacy - Fallback during migration)
# ===========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ===========================================
# Stripe
# ===========================================
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ===========================================
# App Config
# ===========================================
VITE_APP_URL=http://localhost:5173

# API URL (defaults to /api for same-origin deployment)
# For local development with separate API: http://localhost:3000
# For AWS Lambda: https://api.quotemyav.com/v1
VITE_API_URL=/api

# ===========================================
# AWS Infrastructure (Server-side)
# ===========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# SES Email
SES_SENDER_EMAIL=quotes@quotemyav.com
SES_SENDER_NAME=QuoteMyAV

# RDS Database (set via Secrets Manager in production)
# DATABASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:xxx:secret:quotemyav/database

# Anthropic API (set via Secrets Manager in production)
# ANTHROPIC_SECRET_ARN=arn:aws:secretsmanager:us-east-1:xxx:secret:quotemyav/anthropic

# Cognito (server-side verification)
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
